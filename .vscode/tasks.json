{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Clean Build",
      "type": "shell",
      "command": "./scripts/clean.sh",
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Build C++",
      "type": "shell",
      "command": "./scripts/build.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Compile C++ using Cmake"
    },
    {
      "label": "Execute",
      "type": "shell",
      "command": "./techinician_main_agent",
      "dependsOn": [
        "Build C++"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Run the binary after build"
    },
    {
      "label": "Build and Run",
      "type": "shell",
      "command": "./techinician_main_agent",
      "args":[
        "images/exif_1.jpg","1",
        "images/exif_3.jpg","3",
        "images/exif_6.jpg","6",
        "images/exif_8.jpg","8",
        "images/heuristic_no_face.jpg",
        "images/img_8bit.png",
        "images/img16bit.tiff",
        "images/img_alert_saturation.png",
        "images/img_alta.jpg",
        "images/img_baixa.jpg",
        "images/img_media.jpg",
        "images/img_compressed_jpeg.jpg"
      ],
      "dependsOn": [
        "Build C++"
      ],
      "group": {
        "kind": "none"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
